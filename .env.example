# Sintel Technologies — Environment Variables
# Copy this file to .env and fill in real values before running the server.
# Never commit .env to version control.

# PostgreSQL connection string (required for contact form, admin, and content)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/sintel

# Port the Express server listens on (default: 4031)
PORT=4031

# Initial admin password (only used when the admin account is first created)
# Change it immediately via the /admin page after first login.
ADMIN_INITIAL_PASSWORD=sintel-admin-2026
