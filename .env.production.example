# =============================================================================
# .env.production.example — Sintel Technologies
# Copy this to .env and fill in real values before deploying.
# NEVER commit the actual .env file to version control.
# =============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://sintel:STRONGPASSWORD@localhost:5432/sintel

# Server port (must match ecosystem.config.js / docker-compose.yml)
PORT=4031

# Initial admin password — CHANGE THIS immediately after first login!
ADMIN_INITIAL_PASSWORD=CHANGE_ME_NOW

# CORS allowed origin (your production domain)
ALLOWED_ORIGIN=https://yourdomain.com

# Max file upload size in MB
UPLOAD_MAX_SIZE_MB=5

# Node environment
NODE_ENV=production
